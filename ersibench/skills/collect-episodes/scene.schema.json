{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "ERSI collection scene json (scenes/<scene>.json)",
 "description": "Where a task happens: background, workspaces, robot, objects, randomisation, recording. Check: python3 skills/collect-episodes/task_schema.py <file>",
 "type": "object",
 "properties": {
  "scene": {
   "type": "object",
   "properties": {
    "scene_usd": {
     "type": [
      "string",
      "array"
     ],
     "description": "background/<key>/background.usda, <key> in scripts/backgrounds.json"
    },
    "scene_id": {
     "type": "string"
    },
    "scene_info_dir": {
     "type": "string"
    },
    "function_space_objects": {
     "type": "object",
     "additionalProperties": {
      "type": "object",
      "properties": {
       "position": {
        "type": "array",
        "items": {
         "type": "number"
        },
        "minItems": 3,
        "maxItems": 3
       },
       "quaternion": {
        "type": "array",
        "items": {
         "type": "number"
        },
        "minItems": 4,
        "maxItems": 4,
        "description": "wxyz"
       },
       "size": {
        "type": "array",
        "items": {
         "type": "number"
        },
        "minItems": 3,
        "maxItems": 3
       },
       "material_obj_prim": {
        "type": "object"
       },
       "poses": {
        "type": "array",
        "minItems": 1,
        "items": {
         "type": "object",
         "properties": {
          "position": {
           "type": "array",
           "items": {
            "type": "number"
           },
           "minItems": 3,
           "maxItems": 3
          },
          "quaternion": {
           "type": "array",
           "items": {
            "type": "number"
           },
           "minItems": 4,
           "maxItems": 4,
           "description": "wxyz"
          },
          "random": {
           "type": "object",
           "properties": {
            "delta_position": {
             "type": "array",
             "items": {
              "type": "number"
             },
             "minItems": 3,
             "maxItems": 3
            },
            "delta_angle": {
             "type": "number"
            }
           },
           "additionalProperties": false
          }
         },
         "additionalProperties": false,
         "required": [
          "position",
          "quaternion"
         ]
        }
       }
      },
      "if": {
       "required": [
        "poses"
       ]
      },
      "then": {},
      "else": {
       "required": [
        "position",
        "quaternion",
        "size"
       ]
      },
      "description": "area mode: position + quaternion + size, objects placed anywhere inside; pose mode: poses, one is drawn"
     }
    }
   },
   "additionalProperties": false,
   "required": [
    "scene_usd",
    "scene_id",
    "function_space_objects"
   ]
  },
  "origin": {
   "type": "object",
   "properties": {
    "position": {
     "type": "array",
     "items": {
      "type": "number"
     },
     "minItems": 3,
     "maxItems": 3
    },
    "quaternion": {
     "type": "array",
     "items": {
      "type": "number"
     },
     "minItems": 4,
     "maxItems": 4,
     "description": "wxyz"
    }
   },
   "additionalProperties": false,
   "required": [
    "position",
    "quaternion"
   ]
  },
  "robot": {
   "type": "object",
   "properties": {
    "robot_cfg": {
     "type": "string"
    },
    "arm": {
     "type": "string"
    },
    "robot_id": {
     "type": "string"
    },
    "robot_init_pose": {
     "type": "object",
     "properties": {
      "position": {
       "type": "array",
       "items": {
        "type": "number"
       },
       "minItems": 3,
       "maxItems": 3
      },
      "quaternion": {
       "type": "array",
