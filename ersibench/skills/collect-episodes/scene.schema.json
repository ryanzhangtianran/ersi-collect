       },
       "minItems": 4,
       "maxItems": 4,
       "description": "wxyz"
      },
      "random": {
       "type": "object",
       "properties": {
        "delta_position": {
         "type": "array",
         "items": {
          "type": "number"
         },
         "minItems": 3,
         "maxItems": 3
        }
       },
       "additionalProperties": false
      }
     },
     "additionalProperties": false,
     "required": [
      "position",
      "quaternion"
     ]
    },
    "init_arm_pose": {
     "type": "object"
    },
    "init_arm_pose_noise": {
     "type": "object"
    }
   },
   "additionalProperties": false,
   "required": [
    "robot_cfg",
    "robot_init_pose"
   ]
  },
  "objects": {
   "type": "object",
   "properties": {
    "task_related_objects": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "object_id"
      ],
      "properties": {
       "object_id": {
        "type": "string"
       },
       "data_info_dir": {
        "type": "string"
       },
       "candidate_objects": {
        "type": "array"
       },
       "workspace_id": {
        "type": "string"
       },
       "sub_workspace": {
        "type": "object"
       },
       "angle_constraint": {
        "type": "object"
       },
       "extent": {
        "type": "number"
       },
       "english_semantic_name": {
        "type": "string"
       },
       "chinese_semantic_name": {
        "type": "string"
       },
       "mass": {
        "type": "number"
       },
       "interaction": {
        "type": "object"
       }
      },
      "description": "more placement fields: source/data_collection/TASK_CONFIG_GUIDE.md §objects"
     }
    },
    "scene_objects": {
     "type": "array"
    },
    "fix_objects": {
     "type": "array"
    },
    "attach_objects": {
     "type": [
      "array",
      "null"
     ]
    },
    "constraints": {
     "type": [
      "object",
      "null"
     ]
    },
    "fix_pose_random": {
     "type": "object",
     "properties": {
      "shared": {
       "type": "array",
       "items": {
        "type": "number"
       },
       "minItems": 3,
       "maxItems": 3
      },
      "each": {
       "type": "array",
       "items": {
        "type": "number"
       },
       "minItems": 3,
       "maxItems": 3
      }
     },
     "additionalProperties": false
    }
   },
   "additionalProperties": false,
   "required": [
    "task_related_objects"
   ]
  },
  "workspaces": {
   "type": "object"
  },
